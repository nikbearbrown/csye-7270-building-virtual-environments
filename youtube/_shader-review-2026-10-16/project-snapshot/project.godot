; Shader Lessons (Cg to Godot): 16 hand-converted lesson shaders + the test rig that checks them.
; Godot 4.7.2. Not an engine-generated file: written by hand.
config_version=5

[application]

config/name="Shader Lessons (Cg to Godot)"
run/main_scene="res://scenes/stage.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
