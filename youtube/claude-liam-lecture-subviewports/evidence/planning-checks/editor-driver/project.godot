; SubViewports film: scratch project for the series editor driver (../../_godot-shaders-series/editor-capture). The driver plugin is copied in at run time by run-series-driver.sh.
config_version=5

[application]

config/name="subviewports-editor-driver"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/driver/plugin.cfg")
