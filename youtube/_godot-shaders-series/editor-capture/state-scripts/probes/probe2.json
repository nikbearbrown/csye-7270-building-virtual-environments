{
  "boot_frames": 25,
  "steps": [
    {"op": "probe_window", "name": "boot-default"},
    {"op": "open_scene", "path": "res://scenes/e1_sprite.tscn", "settle": 12},
    {"op": "select_node", "node": ".", "settle": 12},
    {"op": "mark", "name": "P2-A-default-window"},
    {"op": "window_set_size", "w": 1920, "h": 1080, "settle": 25},
    {"op": "probe_window", "name": "after-1920x1080"},
    {"op": "mark", "name": "P2-B-window-1920x1080"},
    {"op": "window_set_size", "w": 3840, "h": 2160, "settle": 30},
    {"op": "probe_window", "name": "after-3840x2160"},
    {"op": "mark", "name": "P2-C-window-3840x2160"},
    {"op": "window_set_size", "w": 3456, "h": 1944, "settle": 30},
    {"op": "probe_window", "name": "after-3456x1944"},
    {"op": "mark", "name": "P2-D-window-3456x1944"},
    {"op": "unfold_group", "property": "material", "object": "node", "settle": 10},
    {"op": "mark", "name": "P2-E-material-group-unfolded"},
    {"op": "dump_inspector", "name": "after-unfold-material-group"},
    {"op": "open_picker_menu", "property": "material", "object": "node", "settle": 6},
    {"op": "dump_popup", "name": "material-menu"},
    {"op": "pick_menu_item", "contains": "ShaderMaterial", "settle": 14},
    {"op": "dump_inspector", "name": "after-pick-ShaderMaterial"},
    {"op": "mark", "name": "P2-F-after-pick-ShaderMaterial"},
    {"op": "dump_tree", "name": "tree-inspector-after-pick", "root": "inspector", "max_depth": 16},
    {"op": "wait_frames", "n": 4}
  ]
}
