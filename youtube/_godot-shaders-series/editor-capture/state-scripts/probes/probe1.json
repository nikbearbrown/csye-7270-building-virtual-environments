{
  "boot_frames": 25,
  "steps": [
    {"op": "log", "text": "probe 1: learn what the editor does for each API call"},
    {"op": "open_scene", "path": "res://scenes/e1_sprite.tscn", "settle": 12},
    {"op": "mark", "name": "P1-00-scene-opened"},
    {"op": "dump_tree", "name": "tree-initial", "root": "base", "max_depth": 5},
    {"op": "select_node", "node": ".", "settle": 12},
    {"op": "mark", "name": "P1-01-selected-via-selection"},
    {"op": "dump_inspector", "name": "inspector-after-select"},
    {"op": "dump_tree", "name": "tree-inspector-after-select", "root": "inspector", "max_depth": 7},
    {"op": "inspect_object", "node": ".", "target": "node", "for_property": "material", "settle": 12},
    {"op": "mark", "name": "P1-02-inspect-object-for-property-material"},
    {"op": "scroll_inspector", "property": "material", "object": "node", "align": "top", "margin": 8, "settle": 8},
    {"op": "mark", "name": "P1-03-scrolled-material-to-top"},
    {"op": "dump_inspector", "name": "inspector-scrolled"},
    {"op": "open_picker_menu", "property": "material", "settle": 6},
    {"op": "dump_popup", "name": "material-dropdown"},
    {"op": "mark", "name": "P1-04-material-dropdown-open"},
    {"op": "close_popups", "settle": 6},
    {"op": "assign_new", "node": ".", "property": "material", "class": "ShaderMaterial"},
    {"op": "inspect_object", "node": ".", "target": "node", "for_property": "material", "settle": 12},
    {"op": "scroll_inspector", "property": "material", "object": "node", "align": "top", "margin": 8, "settle": 8},
    {"op": "mark", "name": "P1-05-shadermaterial-assigned"},
    {"op": "unfold_resource", "property": "material", "object": "node", "settle": 12},
    {"op": "mark", "name": "P1-06-material-unfolded"},
    {"op": "dump_inspector", "name": "inspector-material-unfolded"},
    {"op": "dump_tree", "name": "tree-inspector-material-unfolded", "root": "inspector", "max_depth": 12},
    {"op": "assign_shader_file", "node": ".", "path": "res://shaders/06-dial.gdshader", "settle": 14},
    {"op": "mark", "name": "P1-07-shader-assigned"},
    {"op": "dump_inspector", "name": "inspector-shader-assigned"},
    {"op": "edit_resource", "node": ".", "target": "shader", "settle": 20},
    {"op": "mark", "name": "P1-08-shader-editor-after-edit-resource"},
    {"op": "dump_tree", "name": "tree-after-edit-resource", "root": "base", "max_depth": 8},
    {"op": "wait_frames", "n": 4}
  ]
}
