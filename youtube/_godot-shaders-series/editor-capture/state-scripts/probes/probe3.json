{
  "boot_frames": 25,
  "window": [3456, 1944],
  "window_settle": 40,
  "steps": [
    {"op": "probe_window", "name": "boot"},
    {"op": "open_scene", "path": "res://scenes/e1_sprite.tscn", "settle": 12},
    {"op": "select_node", "node": ".", "settle": 12},
    {"op": "dump_scene_tree", "name": "scene-tree"},
    {"op": "dump_object", "name": "dock-hsplit-main", "find": {"name": "DockHSplitMain"}},
    {"op": "dump_object", "name": "dock-vsplit-center", "find": {"name": "DockVSplitCenter"}},
    {"op": "menu_item", "button": "View", "item": "Frame Selection", "settle": 12},
    {"op": "mark", "name": "P3-00-frame-selection"},
    {"op": "unfold_group", "property": "material", "object": "node", "settle": 12},
    {"op": "scroll_inspector", "property": "material", "object": "node", "align": "top", "margin": 120, "settle": 10},
    {"op": "mark", "name": "P3-01-material-empty"},
    {"op": "dump_inspector", "name": "after-unfold"},
    {"op": "open_picker_menu", "property": "material", "object": "node", "settle": 6},
    {"op": "dump_popup", "name": "material-menu"},
    {"op": "pick_menu_item", "contains": "ShaderMaterial", "settle": 14},
    {"op": "scroll_inspector", "property": "material", "object": "node", "align": "top", "margin": 120, "settle": 10},
    {"op": "mark", "name": "P3-02-shadermaterial-in-slot"},
    {"op": "unfold_resource", "property": "material", "object": "node", "settle": 14},
    {"op": "scroll_inspector", "property": "material", "object": "node", "align": "top", "margin": 120, "settle": 10},
    {"op": "mark", "name": "P3-03-material-unfolded-shader-empty"},
    {"op": "dump_inspector", "name": "material-unfolded"},
    {"op": "open_picker_menu", "property": "shader", "object": "material", "settle": 6},
    {"op": "dump_popup", "name": "shader-menu"},
    {"op": "close_popups", "settle": 6},
    {"op": "assign_shader_file", "node": ".", "path": "res://shaders/06-dial.gdshader", "settle": 14},
    {"op": "mark", "name": "P3-04-after-assign-shader"},
    {"op": "dump_inspector", "name": "after-assign-shader"},
    {"op": "dump_tree", "name": "tree-after-assign", "root": "base", "max_depth": 4},
    {"op": "hide_bottom_panel", "settle": 6},
    {"op": "select_node", "node": ".", "settle": 14},
    {"op": "scroll_inspector", "property": "material", "object": "node", "align": "top", "margin": 120, "settle": 10},
    {"op": "mark", "name": "P3-05-shader-in-slot-sprite-inspector"},
    {"op": "dump_inspector", "name": "shader-in-slot"},
    {"op": "edit_resource", "node": ".", "target": "shader", "settle": 20},
    {"op": "mark", "name": "P3-06-shader-editor-open"},
    {"op": "wait_frames", "n": 4}
  ]
}
