    {"op": "select_option", "within": {"class": "ProjectSettingsEditor"}, "index": 0, "text": "gl_compatibility", "settle": 20},
    {"op": "dump_texts", "within": {"class": "ProjectSettingsEditor"}, "name": "after-change-texts"},
    {"op": "dump_windows", "name": "windows-after-change"},
    {"op": "mark", "name": "FU-D1-restart-note"},
    {"op": "select_option", "within": {"class": "ProjectSettingsEditor"}, "index": 0, "text": "forward_plus", "settle": 20},
    {"op": "dump_texts", "within": {"class": "ProjectSettingsEditor"}, "name": "after-revert-texts"},
