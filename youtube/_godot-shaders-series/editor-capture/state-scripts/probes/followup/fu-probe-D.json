    {"op": "dump_texts", "within": {"class": "EditorSettingsDialog"}, "name": "es-search-advanced-on-texts"},
    {"op": "dump_rows", "within": {"class": "EditorSettingsDialog"}, "name": "es-search-advanced-on-rows"},
    {"op": "mark", "name": "FU-D5-search-renderer-advanced-on"},
