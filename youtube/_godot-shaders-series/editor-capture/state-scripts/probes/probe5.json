    {"op": "dump_windows", "name": "windows-with-material-menu"},
    {"op": "dump_popup", "name": "material-menu"},
    {"op": "mark", "name": "P5-A-material-dropdown-open"},
    {"op": "pick_menu_item", "contains": "ShaderMaterial", "settle": 14},
    {"op": "unfold_resource", "property": "material", "object": "node", "settle": 16},
    {"op": "open_picker_menu", "property": "shader", "object": "material", "settle": 8},
    {"op": "dump_windows", "name": "windows-with-shader-menu"},
    {"op": "mark", "name": "P5-B-shader-dropdown-open"},
