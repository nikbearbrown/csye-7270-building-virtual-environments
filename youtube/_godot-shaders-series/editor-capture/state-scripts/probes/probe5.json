    {"op": "dump_windows", "name": "windows-after-new-shader"},
    {"op": "mark", "name": "P5-C-after-new-shader-pick"},
    {"op": "dump_tree", "name": "create-shader-dialog", "root": {"class": "ShaderCreateDialog"}, "max_depth": 12},
    {"op": "wait_frames", "n": 2}
  ]
