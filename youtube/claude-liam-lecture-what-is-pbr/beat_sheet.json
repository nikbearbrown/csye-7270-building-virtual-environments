      "beat_id": "B01",
      "act": "Five Measurements",
      "lane": "body",
      "proof_gate": "SHOW",
      "narration_text": "P B R stands for physically based rendering. Instead of painting how a surface looks, you measure what it is. Godot's Standard Material 3D holds five measurements: base colour, metallic, roughness, normal and ambient occlusion.",
      "estimated_duration_s": 14.58,
      "voice": "am_onyx",
      "engine": "kokoro",
      "shot": {
        "type": "GRAPHIC",
        "source": "own",
        "visual_intent": "Five labelled measurement slots fill one by one beside a sphere; the word PBR expands to its three words",
        "motion_claim": "Each slot lands on its spoken name",
        "show": [
          {
            "at": 0,
            "event": "Establish"
          },
          {
            "at": 0.3,
            "event": "Each slot lands on its spoken name"
