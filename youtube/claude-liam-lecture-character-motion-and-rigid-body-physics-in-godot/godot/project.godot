config_version=5
[application]
config/name="Scenes, Collision, and Physics — Evidence Lab"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.949, 0.941, 0.914, 1)
[physics]
common/physics_ticks_per_second=60
2d/default_gravity=980.0
[layer_names]
2d_physics/layer_1="world"
2d_physics/layer_2="one_way"
2d_physics/layer_3="player"
2d_physics/layer_4="enemy"
2d_physics/layer_5="pickup"
2d_physics/layer_6="hazard"
2d_physics/layer_7="debris"
