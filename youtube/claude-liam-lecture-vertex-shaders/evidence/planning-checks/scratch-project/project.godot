; Scratch project for the Vertex Shaders film's planning checks (not the Shader Lab).
; Lives at <film>/evidence/planning-checks/scratch-project/ ; the scripts find the film's lab-shaders/ and check-shaders/ from here.
config_version=5

[application]

config/name="vertex-shaders-scratch"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
