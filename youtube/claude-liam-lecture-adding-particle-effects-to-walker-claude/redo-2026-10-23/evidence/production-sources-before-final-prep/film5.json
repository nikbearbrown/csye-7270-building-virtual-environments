    {
      "act": "Read The Game And Its Contract",
      "narration": "This editor lab is derived from the current Signal Garden geometry. It is not a recovered historical revision. We will reintroduce the effect resources in inspectable steps, then load those resources through the existing game\u2019s actual event paths.",
      "actions": [
        {
          "op": "open",
          "path": "res://arena.tscn"
        },
        {
          "at": 0.5,
          "op": "view3d",
          "angle": 45,
          "orbit": false
        }
      ],
      "focus": "viewport"
    },
    {
      "act": "Build The Milestone Burst",
      "narration": "Add CPU Particles Three D at the pad. Keep it initially inactive, with thirty-two particles, a seven-tenths-second lifetime, one-shot enabled, and full explosiveness. The CPU node stores its motion controls directly, rather than using a Particle Process Material.",
      "actions": [
        {
          "op": "set",
          "property": "heading",
          "value": "Build The Milestone Burst",
          "node": "."
        },
        {
          "at": 0.4,
          "op": "add",
          "class_name": "CPUParticles3D",
          "name": "Burst",
          "properties": {
            "position": {
              "v3": [
                -2,
                0.4,
                0
              ]
            },
            "emitting": false,
            "amount": 32,
            "lifetime": 0.7,
            "one_shot": true,
            "explosiveness": 1,
            "randomness": 0.1,
            "process_mode": 1,
            "local_coords": false,
            "use_fixed_seed": true,
            "seed": 7270
          }
        }
      ],
      "focus": "viewport"
    },
    {
      "act": "Build The Milestone Burst",
      "narration": "Assign a small sphere mesh and an unshaded surface material that uses vertex colors. Now the emitter has something to draw. We keep the same low-detail mesh as the original effect while establishing its behavior.",
      "actions": [
        {
          "op": "set",
          "property": "mesh",
          "value": {
            "new": "SphereMesh",
            "props": {
              "radius": 0.045,
              "height": 0.09,
              "radial_segments": 8,
              "rings": 4,
              "material": {
                "new": "StandardMaterial3D",
                "props": {
                  "shading_mode": 0,
                  "vertex_color_use_as_albedo": true
                }
              }
            }
          },
          "node": "Burst"
        },
        {
          "at": 0.5,
          "op": "set",
          "property": "color",
          "value": {
            "color": "2ed99e"
          },
          "node": "Burst"
        }
      ],
      "focus": "viewport"
    },
    {
      "act": "Build The Milestone Burst",
      "narration": "Launch upward between one point three and two point two meters per second, with downward gravity. Restart the preview. The burst is a short milestone cue, so its compact arc should remain close to the event it describes.",
