{
  "slug": "claude-liam-lecture-adding-particle-effects-to-walker-claude",
  "title": "Adding Particle Effects to Walker Claude",
  "payoff": "Connect two effects to real game contracts",
  "summary": "Build, revise, test, and price a milestone burst and open-route motes in Signal Garden.",
  "framing": "Can a good-looking preset prove that an effect belongs in a game? We will connect two different visual jobs to the real game, then check their behavior, revisions, and cost.",
  "question": "A good effect is\na good-looking preset",
  "trigger": "good-looking preset",
  "replacement": "tested game contract",
  "terms": [
    {
      "term": "Event",
      "meaning": "A specific occurrence that can trigger a burst"
    },
    {
      "term": "Condition",
      "meaning": "A state that can allow ongoing emission"
    },
    {
      "term": "Revision",
      "meaning": "A preserved change with a reason and comparison"
    },
    {
      "term": "Baseline",
      "meaning": "The comparison condition used by a test"
    }
  ],
