        "show": [
          {
            "at": 0,
            "event": "Act: Trace The Model. The Missing Dark Side"
          },
          {
            "at": 0.18,
            "event": "Highlight the exact source expression: vec3 lambert"
          }
        ],
        "motion_claim": "Highlight the exact source expression: vec3 lambert",
        "remotion": {
          "pattern": "ShaderLab",
          "props": {
            "title": "Trace The Model",
            "videoAspect": 2.064516129032258,
            "layout": "code",
