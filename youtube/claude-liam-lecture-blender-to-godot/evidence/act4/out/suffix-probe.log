== A. fresh import (Godot 4.7.2 defaults)
nodes/use_name_suffixes=true
nodes/use_node_type_suffixes=true
Node3D [post_suffixes]
  MeshInstance3D [Mesh0]
  MeshInstance3D [Mesh1]
    StaticBody3D [StaticBody3D]
      CollisionShape3D [CollisionShape3D]  shape=ConcavePolygonShape3D
  MeshInstance3D [Mesh2]
    StaticBody3D [StaticBody3D]
      CollisionShape3D [CollisionShape3D]  shape=ConvexPolygonShape3D
  StaticBody3D [Mesh3]
    CollisionShape3D [CollisionShape3D]  shape=ConcavePolygonShape3D
  StaticBody3D [Mesh4]
    CollisionShape3D [CollisionShape3D]  shape=ConvexPolygonShape3D
  Node3D [Marker-colonly]

== B. nodes/use_node_type_suffixes=false only
nodes/use_name_suffixes=true
nodes/use_node_type_suffixes=false
Node3D [post_suffixes]
  MeshInstance3D [Mesh0]
  MeshInstance3D [Mesh1-col]
  MeshInstance3D [Mesh2-convcol]
  MeshInstance3D [Mesh3-colonly]
  MeshInstance3D [Mesh4-convcolonly]
  Node3D [Marker-colonly]

== C. the demo's enemy.glb.import [params] copied over
nodes/use_name_suffixes=false
nodes/use_node_type_suffixes=false
Node3D [post_suffixes]
  MeshInstance3D [Mesh0]
  MeshInstance3D [Mesh1-col]
  MeshInstance3D [Mesh2-convcol]
  MeshInstance3D [Mesh3-colonly]
  MeshInstance3D [Mesh4-convcolonly]
  MeshInstance3D [Mesh5-noimp]
  Node3D [Marker-colonly]
