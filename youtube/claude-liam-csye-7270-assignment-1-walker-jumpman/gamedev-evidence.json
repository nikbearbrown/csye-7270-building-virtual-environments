      "start_line": 74,
      "end_line": 80,
      "text": "\tdraw_rect(Rect2(-9, -27, 18, 24), ink)\n\tdraw_rect(Rect2(-7, -25, 14, 20), blue)\n\tdraw_rect(Rect2(-10, -18, 20, 4), Color(\"ef875f\"))\n\tdraw_rect(Rect2(-6, -4, 5, 4 + stride), ink)\n\tdraw_rect(Rect2(2, -4, 5, 4 - stride), ink)\n\tdraw_rect(Rect2(1 if facing > 0 else -6, -24, 5, 5), Color(\"fff9e9\"))\n\tdraw_rect(Rect2(4 if facing > 0 else -6, -23, 2, 3), ink)"
    },
    {
      "beat_id": "B09",
      "path": "features/player/player.gd",
      "start_line": 23,
      "end_line": 28,
      "text": "\tvar shape := RectangleShape2D.new()\n\tshape.size = Vector2(18, 28)\n\tvar collider := CollisionShape2D.new()\n\tcollider.shape = shape\n\tcollider.position = Vector2(0, -14)\n\tadd_child(collider)"
    },
    {
      "beat_id": "B11",
      "path": "features/player/player.gd",
      "start_line": 56,
      "end_line": 60,
      "text": "\tvar rate: float = tuning.acceleration if not is_zero_approx(axis) else tuning.deceleration\n\tvelocity.x = move_toward(velocity.x, axis * tuning.speed, rate * delta)\n\tif not is_zero_approx(axis):\n\t\tfacing = signf(axis)\n\tvelocity.y = minf(velocity.y + tuning.gravity * delta, tuning.terminal_velocity)"
    },
    {
      "beat_id": "B13",
      "path": "levels/first_steps.json",
      "start_line": 5,
      "end_line": 10,
      "text": "  \"width\": 960,\n  \"fall_y\": 430,\n  \"spawn\": [64, 320],\n  \"solids\": [[0, 320, 448, 64], [512, 320, 224, 64], [784, 320, 176, 64], [160, 304, 48, 16], [576, 288, 48, 32]],\n  \"hazards\": [[320, 304, 24, 16]],\n  \"finish\": [916, 264, 24, 56]"
    },
    {
      "beat_id": "B15",
      "path": "game/session.gd",
      "start_line": 198,
      "end_line": 201,
      "text": "\tfor entry in level.hazards:\n\t\tfor i in range(3):\n\t\t\tvar x: float = entry[0] + i*8\n\t\t\tdraw_colored_polygon(PackedVector2Array([Vector2(x,320),Vector2(x+4,304),Vector2(x+8,320)]), Color(\"d24e42\"))"
    },
    {
      "beat_id": "B17",
