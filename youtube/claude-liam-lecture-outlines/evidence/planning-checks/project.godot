; Scratch project for the outline film's GDScript checks (copy the scripts next to this file, then:
;   godot --path <this folder> --script res://<script>.gd )
config_version=5

[application]

config/name="outline-verify"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
