; Making Water in Godot: the openable project behind the film's captures.
; Engine: Godot 4.7.2. Renderer: Forward+ (the default). Open this folder in the editor and run scenes/water.tscn.
config_version=5

[application]

config/name="Making Water in Godot"
run/main_scene="res://scenes/water.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
