; Scratch project settings for re-running the verify*.gd scripts in this folder:
;   mkdir -p /private/tmp/scratch-shaders-in-3d && cp project.godot verify*.gd /private/tmp/scratch-shaders-in-3d/
;   godot --path /private/tmp/scratch-shaders-in-3d --script res://verify1-mesh-uv.gd
; (the scripts that load a shader read it by absolute path from ../../lab-shaders, set in each script's header).
config_version=5

[application]

config/name="shaders-in-3d-checks"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
