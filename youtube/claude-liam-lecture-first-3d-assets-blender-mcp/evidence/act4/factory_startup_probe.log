# user config = a copy of evidence/blender_config (its userpref.blend sets ui_scale 2.0, splash off)
$ BLENDER_USER_CONFIG=<copy> Blender -b --python-expr "import bpy; p=bpy.context.preferences; print('PROBE ui_scale', p.view.ui_scale, '| show_splash', p.view.show_splash)"
PROBE ui_scale 2.0 | show_splash False
$ BLENDER_USER_CONFIG=<copy> Blender -b --factory-startup --python-expr "import bpy; p=bpy.context.preferences; print('PROBE ui_scale', p.view.ui_scale, '| show_splash', p.view.show_splash)"
PROBE ui_scale 1.0 | show_splash True
