; A throwaway project for checking CLAUDE.md's headless facts about
; particles on this machine. Nothing in the game uses it. Its renderer
; matches the game's (game/project.godot:95-96) for the windowed run.

config_version=5

[application]

config/name="Headless particles probe"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
