# Engine caches and local editor state (Godot 4 *.import files ARE committed)
.godot/
.DS_Store
.idea/
.vscode/

# Course rule: no MP3/MP4 or other video in git, and nothing over 25 MB.
# Git cannot ignore by size: inspect staged files before committing.
*.[mM][pP]3
*.[mM][pP]4
*.avi
*.mov
exports/
builds/

# Local working folder of full-size downloads, including rejected outputs. Accepted originals
# (generated/accepted/), rejected thumbnails (generated/rejected/) and the game's edited assets are committed.
_raw/

# Game audio (OGG/WAV) is committed: the slice's sound effects and music live in git.
# Only the film's narration and scratch audio is ignored (see the reel rules below).

# Local credentials and configuration: never commit API keys or account credentials
.env
.env.*
!.env.example
credentials/
*.p12
*.pfx

# Python helper scripts
__pycache__/
.venv/

# ── Film reel (youtube/<slug>/) ──────────────────────────────────────────────
# Media is handed off through the course media storage and linked from README.md.
# Recipes and evidence are committed; regenerable build products are not.
youtube/**/*.wav
youtube/**/clips/
youtube/**/_build/
youtube/**/_stale/
youtube/**/build-state.json
youtube/**/todo.json
youtube/**/STATUS.md
youtube/**/ToDo.md
youtube/**/qc-sheet.png
youtube/**/images/
youtube/**/manim/
youtube/**/pantry/
