# Blender keeps older saves next to the file (Save Versions); they are not source
*.blend[0-9]*
# Godot editor cache
.godot/
# The game's six sound effects are game assets, not rendered media; the root
# .gitignore's *.wav rule would leave them out of the commit, and the game
# names them (A2 force-added them)
!game/systems/audio/sfx/*.wav
