 "excerpts": [
  {
   "beat_id": "B11",
   "path": "shaders/weathered_stone.gdshader",
   "start_line": 3,
   "end_line": 13,
   "text": "uniform sampler2D albedo_tex : source_color, filter_linear_mipmap, repeat_enable;\nuniform sampler2D normal_tex : hint_normal, filter_linear_mipmap, repeat_enable;\nuniform sampler2D roughness_tex : filter_linear_mipmap, repeat_enable;\n\ngroup_uniforms surface;\nuniform vec4 albedo_tint : source_color = vec4(1.0);\nuniform float uv_scale : hint_range(0.25, 4.0, 0.05) = 1.0;\n\ngroup_uniforms relief;\nuniform float normal_strength : hint_range(0.0, 2.0, 0.05) = 1.0;\nuniform float roughness_offset : hint_range(-0.5, 0.5, 0.01) = 0.0;"
  },
  {
   "beat_id": "B13",
   "path": "shaders/weathered_stone.gdshader",
   "start_line": 16,
   "end_line": 22,
   "text": "void fragment() {\n\tvec2 scaled_uv = UV * uv_scale;\n\tALBEDO = texture(albedo_tex, scaled_uv).rgb * albedo_tint.rgb;\n\tNORMAL_MAP = texture(normal_tex, scaled_uv).rgb;\n\tNORMAL_MAP_DEPTH = normal_strength;\n\tROUGHNESS = clamp(texture(roughness_tex, scaled_uv).r + roughness_offset, 0.0, 1.0);\n}"
  },
  {
   "beat_id": "B15",
   "path": "shaders/hint_experiment.gdshader",
   "start_line": 2,
   "end_line": 13,
   "text": "render_mode unshaded;\n\nuniform sampler2D source_color_tex : source_color, filter_nearest;\nuniform sampler2D plain_tex : filter_nearest;\nuniform bool use_source_color = false;\n\nvoid fragment() {\n\tif (use_source_color) {\n\t\tALBEDO = texture(source_color_tex, UV).rgb;\n\t} else {\n\t\tALBEDO = texture(plain_tex, UV).rgb;\n\t}"
  },
  {
   "beat_id": "B17",
   "path": "materials/circle_darkstone.tres",
   "start_line": 8,
   "end_line": 16,
   "text": "[resource]\nshader = ExtResource(\"1_shader\")\nshader_parameter/albedo_tex = ExtResource(\"2_albedo\")\nshader_parameter/normal_tex = ExtResource(\"3_normal\")\nshader_parameter/roughness_tex = ExtResource(\"4_roughness\")\nshader_parameter/albedo_tint = Color(0.6431373, 0.654902, 0.7058824, 1)\nshader_parameter/uv_scale = 1.0\nshader_parameter/normal_strength = 0.35\nshader_parameter/roughness_offset = -0.25"
  }
 ],
 "exclusions": [
