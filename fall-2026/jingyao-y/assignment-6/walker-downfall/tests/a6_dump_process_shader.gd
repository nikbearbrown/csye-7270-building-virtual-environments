extends SceneTree
## A6 Step 6 (agent, 2026-11-07): writes the shader Godot generates for a
## unique copy of Effect A's Sparks ParticleProcessMaterial to
## res://shaders/particles_generated.gdshader. Nothing in the game uses it.
## The editor's "Convert to ShaderMaterial" reads the same generated code from
## the RenderingServer; this does it from a script because the agent cannot use
## the Inspector menu. Run windowed (a real renderer):
##   Godot_v4.7.2-stable_win64_console.exe --path . --script res://tests/a6_dump_process_shader.gd

const OUT := "res://shaders/particles_generated.gdshader"

func _init() -> void:
	var scene := (load("res://effects/hit_spark.tscn") as PackedScene).instantiate()
	var sparks := scene.get_node("Sparks") as GPUParticles3D
	var copy := (sparks.process_material as ParticleProcessMaterial).duplicate(true) as ParticleProcessMaterial
	await process_frame
	await process_frame
	var code := RenderingServer.shader_get_code(copy.call("_get_shader_rid"))
	print("renderer ", RenderingServer.get_current_rendering_method(), " adapter '", RenderingServer.get_video_adapter_name(), "'")
	print("generated code length ", code.length())
	if code.is_empty():
		print("FAIL no code from RenderingServer")
		quit(1)
		return
	var header := "// Generated by Godot 4.7.2 for a unique copy of effects/hit_spark.tscn Sparks\n// ParticleProcessMaterial (tests/a6_dump_process_shader.gd, 2026-11-07). Reference only; unused.\n"
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(header + code)
	f.close()
	print("wrote ", OUT)
	scene.free()
	quit(0)
