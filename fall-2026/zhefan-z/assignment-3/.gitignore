# Assignment 3 local ignores (scoped to this folder; the root .gitignore is shared)
# Note: Godot's per-asset *.import files (e.g. rock.glb.import) MUST be committed — never ignore *.import

# Godot cache
.godot/
.import/

# Blender backups (Save Versions: .blend1, .blend2, ...) and in-progress save files
*.blend[0-9]*
*.blend@

# Audio / video (course rule: kept out of GitHub; also covered partly at root)
*.mp3
*.mp4
*.wav
*.flac
*.avi

# Python bytecode
__pycache__/
*.pyc

# Credentials, tokens and account details
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials*
secrets*
*token*.txt
hf_token*
*service-account*.json
export_credentials.cfg
