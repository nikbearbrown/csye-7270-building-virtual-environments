diff --git a/godot/player.gd b/godot/player.gd
index 43c366a..ba5596e 100644
--- a/godot/player.gd
+++ b/godot/player.gd
@@ -4,10 +4,14 @@ signal hit
 
 @export var speed = 400 # How fast the player will move (pixels/sec).
 var screen_size # Size of the game window.
+var shielded := false
+var shield_timer := 0.0
+const SHIELD_DURATION := 3.0
 
 func _ready():
 	screen_size = get_viewport_rect().size
 	hide()
+	area_entered.connect(_on_area_entered)
 
 
 func _process(delta):
@@ -41,14 +45,47 @@ func _process(delta):
 		rotation = PI if velocity.y > 0 else 0
 
 
+func _physics_process(delta):
+	if shielded:
+		shield_timer -= delta
+		if shield_timer <= 0.0:
+			shielded = false
+			modulate = Color.WHITE
+			# If a mob body is already overlapping, hit now.
+			for body in get_overlapping_bodies():
+				_on_body_entered(body)
+				return
+
+
 func start(pos):
 	position = pos
 	rotation = 0
 	show()
 	$CollisionShape2D.disabled = false
+	clear_shield()
+
+
+func activate_shield() -> void:
+	shielded = true
+	shield_timer = SHIELD_DURATION
+	modulate = Color(0.4, 0.8, 1.0)
+
+
+func clear_shield() -> void:
+	shielded = false
+	shield_timer = 0.0
+	modulate = Color.WHITE
+
+
+func _on_area_entered(area: Area2D) -> void:
+	if area.is_in_group("pickups"):
+		activate_shield()
+		area.queue_free()
 
 
 func _on_body_entered(_body):
+	if shielded:
+		return
 	hide() # Player disappears after being hit.
 	hit.emit()
 	# Must be deferred as we can't change physics properties on a physics callback.
