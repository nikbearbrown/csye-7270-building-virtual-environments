diff --git a/tests/score_route.gd b/tests/score_route.gd
new file mode 100644
index 0000000..ff67269
--- /dev/null
+++ b/tests/score_route.gd
@@ -0,0 +1,107 @@
+extends SceneTree
+## Deterministic score route, NOT a human playtest.
+## The driver observes game state and uses only the normal paddle input actions.
+
+const ACTIONS := ["left_move_up", "left_move_down", "right_move_up", "right_move_down"]
+const MAX_FRAMES := 30 * 60
+
+var game: Node
+var frame := 0
+var contacts := {"LeftWall": 0, "RightWall": 0}
+var left_paddle_contacts := 0
+
+
+func _initialize() -> void:
+	seed(7375)
+	root.size = Vector2i(640, 400)
+	root.content_scale_size = Vector2i(640, 400)
+	root.content_scale_mode = Window.CONTENT_SCALE_MODE_CANVAS_ITEMS
+	root.content_scale_aspect = Window.CONTENT_SCALE_ASPECT_KEEP
+	call_deferred("start_game")
+
+
+func start_game() -> void:
+	game = load("res://pong.tscn").instantiate()
+	root.add_child(game)
+	current_scene = game
+	for wall_name in contacts:
+		game.get_node(wall_name).area_entered.connect(func(area: Area2D):
+			if area.name == "Ball":
+				contacts[wall_name] += 1
+		)
+	game.get_node("Left").area_entered.connect(func(area: Area2D):
+		if area.name == "Ball":
+			left_paddle_contacts += 1
+	)
+
+
+func _process(_delta: float) -> bool:
+	if game == null:
+		return false
+	_release_actions()
+	var ball := game.get_node("Ball") as Area2D
+	var left := game.get_node("Left") as Area2D
+	var right := game.get_node("Right") as Area2D
+
+	if contacts.LeftWall == 0:
+		# Move Left away so the opening leftward ball produces a real miss.
+		Input.action_press("left_move_down")
+	elif left_paddle_contacts == 0:
+		_track(left, ball, "left")
+	else:
+		# After Left returns the ball, move Right toward the opposite edge.
+		_evade(right, ball, "right")
+
+	frame += 1
+	if contacts.LeftWall > 0 and contacts.RightWall > 0:
+		finish(false)
+	elif frame >= MAX_FRAMES:
+		finish(true)
+	return false
+
+
+func _track(paddle: Area2D, ball: Area2D, side: String) -> void:
+	var error := ball.position.y - paddle.position.y
+	if absf(error) > 2.0:
+		Input.action_press(side + ("_move_down" if error > 0.0 else "_move_up"))
+
+
+func _evade(paddle: Area2D, ball: Area2D, side: String) -> void:
+	var target_y := 16.0 if ball.position.y > 200.0 else 384.0
+	if absf(target_y - paddle.position.y) > 2.0:
+		Input.action_press(side + ("_move_down" if target_y > paddle.position.y else "_move_up"))
+
+
+func _release_actions() -> void:
+	for action in ACTIONS:
+		Input.action_release(action)
+
+
+func finish(timed_out: bool) -> void:
+	_release_actions()
+	var scoreboard := game.get_node("Scoreboard")
+	var left_score: int = scoreboard.left_score
+	var right_score: int = scoreboard.right_score
+	var checks := {
+		"completed_route": not timed_out,
+		"left_score_matches_right_wall": left_score == contacts.RightWall,
+		"right_score_matches_left_wall": right_score == contacts.LeftWall,
+		"left_label_matches_score": scoreboard.get_node("LeftScore").text == str(left_score),
+		"right_label_matches_score": scoreboard.get_node("RightScore").text == str(right_score),
+	}
+	var passed := true
+	for value in checks.values():
+		passed = passed and value
+	var report := {
+		"engine": Engine.get_version_info().string,
+		"method": "scripted-input; normal input actions only; no score or ball writes",
+		"human_playtest": false,
+		"frames": frame,
+		"wall_contacts": contacts,
+		"scores": {"Left": left_score, "Right": right_score},
+		"labels": {"Left": scoreboard.get_node("LeftScore").text, "Right": scoreboard.get_node("RightScore").text},
+		"checks": checks,
+		"passed": passed,
+	}
+	print(JSON.stringify(report))
+	quit(0 if passed else 1)
