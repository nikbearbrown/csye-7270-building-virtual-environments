diff --git a/godot/rl/README.md b/godot/rl/README.md
new file mode 100644
index 0000000..1163684
--- /dev/null
+++ b/godot/rl/README.md
@@ -0,0 +1,84 @@
+# Lab A: tabular Q-learning
+
+Pure GDScript, with a zero-initialized 25 × 4 Q-table, alpha 0.1 and gamma
+0.95. Actions are up, down, left, right. Greedy ties select the first action
+in that order. The learner owns one RandomNumberGenerator, seeded once at
+construction; all exploration uses that generator. Evaluation consumes no
+random numbers. No addons, Python, or neural network are used.
+
+Run from the repository root (no editor or game window is opened):
+
+```sh
+godot --headless --path godot --script res://tests/test_qlearning.gd
+godot --headless --path godot --script res://tests/test_qlearning.gd
+godot --headless --path godot --script res://tests/test_qlearning.gd -- --seed=7
+```
+
+Epsilon decreases linearly across all 500 training episodes:
+`1.0 + (0.05 - 1.0) * (episode - 1) / 499`. Logged epsilon is the value used
+for that episode. Each report summarizes the preceding nonoverlapping 25
+episodes; returns are undiscounted reward sums and success rates are fractions.
+The goal/pit reward replaces the usual step cost. Goal and pit transitions
+have no bootstrap term. The 50-step limit truncates an episode but still
+bootstraps its final update, since the underlying cell is not terminal.
+
+## Observed results
+
+Verified with Godot 4.7.2.stable.official.ed1daf0bf. All three runs exited 0,
+passed the environment/update checks and greedy evaluation, and finished in
+under one second. Godot emitted a macOS system CA certificate diagnostic at
+startup; it did not prevent the tests from running.
+
+The two default-seed runs produced identical complete logs (`diff -u` had no
+output), including all 20 learning-curve rows. The recorded curves are
+[seed42-run1.csv](results/seed42-run1.csv),
+[seed42-run2.csv](results/seed42-run2.csv), and [seed7.csv](results/seed7.csv).
+These headerless files use columns `episode,mean_return,success_rate,epsilon`.
+Recheck the default curves with:
+
+```sh
+cmp godot/rl/results/seed42-run1.csv godot/rl/results/seed42-run2.csv
+```
+
+| Seed | Last 25 mean return | Last 25 success rate | Final epsilon | Greedy steps |
+| --- | ---: | ---: | ---: | ---: |
+| 42, both runs | 0.689600 | 88% | 0.05 | 8 |
+| 7 | 0.850000 | 96% | 0.05 | 8 |
+
+**First full 25-episode window at 100% success: none within 500 episodes,
+for either seed.** This was checked both as a rolling window (25 consecutive
+successful episodes, with the ending episode reported) and as the printed
+nonoverlapping windows. Both corresponding output fields are `-1`. Continuing
+exploration can enter pits even after the greedy policy has learned a safe path.
+
+Seed 7 changed the learning curve, final arrow grid, and chosen optimal route;
+the epsilon schedule and successful 8-step greedy result stayed the same.
+
+Coordinates below are `(x, y)`, with x increasing rightward and y downward.
+The final greedy path for seed 42 (both runs) was:
+
+```text
+(0,0) → (0,1) → (0,2) → (1,2) → (2,2) → (2,3) → (3,3) → (4,3) → (4,4)
+```
+
+Seed 7:
+
+```text
+(0,0) → (0,1) → (0,2) → (1,2) → (1,3) → (1,4) → (2,4) → (3,4) → (4,4)
+```
+
+Both avoid the pits and attain the Manhattan lower bound of 8 steps, with
+greedy return 0.93. The test prints an arrow for every cell, including terminal
+cells: arrows at pits `(1,1)`, `(3,2)` and goal `(4,4)` are unused tie-break
+actions from zero-valued terminal rows, not instructions to leave those cells.
+
+## What this experiment does not show
+
+It does not establish convergence or reliability across arbitrary seeds, nor
+100% success under continued exploration. Greedy evaluation covers only the
+fixed start on this deterministic map, not optimal behavior from every cell.
+Matching runs establish repeatability for this implementation and engine,
+not identical random sequences across future engine versions. Two seeds do
+not constitute a statistical performance study. A small table on one map
+does not demonstrate generalization to unseen maps, large/continuous state
+spaces, stochastic environments, or neural-network learning.
diff --git a/godot/rl/gridworld.gd b/godot/rl/gridworld.gd
new file mode 100644
index 0000000..f48e88a
--- /dev/null
+++ b/godot/rl/gridworld.gd
@@ -0,0 +1,45 @@
+extends RefCounted
+## Coordinates are (column, row); positive y points down.
+
+const SIZE := 5
+const START := Vector2i(0, 0)
+const GOAL := Vector2i(4, 4)
+const PITS := [Vector2i(1, 1), Vector2i(3, 2)]
+const MAX_STEPS := 50
+enum Action { UP, DOWN, LEFT, RIGHT }
+const DIRECTIONS := [Vector2i.UP, Vector2i.DOWN, Vector2i.LEFT, Vector2i.RIGHT]
+
+var position := START
+var steps := 0
+var done := false
+
+
+func reset() -> int:
+	position = START
+	steps = 0
+	done = false
+	return state_id(position)
+
+
+func state_id(cell: Vector2i) -> int:
+	return cell.y * SIZE + cell.x
+
+
+func step(action: int) -> Dictionary:
+	assert(not done, "Reset before stepping a finished episode")
+	assert(action >= 0 and action < DIRECTIONS.size(), "Invalid action")
+	var candidate: Vector2i = position + DIRECTIONS[action]
+	position = candidate.clamp(Vector2i.ZERO, Vector2i(SIZE - 1, SIZE - 1))
+	steps += 1
+	var success := position == GOAL
+	var pit := position in PITS
+	var terminated := success or pit
+	done = terminated or steps >= MAX_STEPS
+	return {
+		"state": state_id(position),
+		"reward": 1.0 if success else (-1.0 if pit else -0.01),
+		"terminated": terminated,
+		"done": done,
+		"success": success,
+		"pit": pit,
+	}
diff --git a/godot/rl/q_learner.gd b/godot/rl/q_learner.gd
new file mode 100644
index 0000000..4d845a4
--- /dev/null
+++ b/godot/rl/q_learner.gd
@@ -0,0 +1,45 @@
+extends RefCounted
+## One RNG, seeded once on construction. Greedy ties use action order.
+
+const ALPHA := 0.1
+const GAMMA := 0.95
+const EPSILON_START := 1.0
+const EPSILON_END := 0.05
+const ACTION_COUNT := 4
+
+var q_table: Array[PackedFloat64Array] = []
+var rng := RandomNumberGenerator.new()
+var epsilon := EPSILON_START
+
+
+func _init(seed_value: int = 42, state_count: int = 25) -> void:
+	rng.seed = seed_value
+	for state in range(state_count):
+		q_table.append(PackedFloat64Array([0.0, 0.0, 0.0, 0.0]))
+
+
+func set_training_episode(index: int, episode_count: int) -> void:
+	var fraction := clampf(float(index) / maxi(episode_count - 1, 1), 0.0, 1.0)
+	epsilon = lerpf(EPSILON_START, EPSILON_END, fraction)
+
+
+func greedy_action(state: int) -> int:
+	var best := 0
+	for action in range(1, ACTION_COUNT):
+		if q_table[state][action] > q_table[state][best]:
+			best = action
+	return best
+
+
+func choose_action(state: int, explore: bool = true) -> int:
+	if explore and rng.randf() < epsilon:
+		return rng.randi_range(0, ACTION_COUNT - 1)
+	return greedy_action(state)
+
+
+func update(state: int, action: int, reward: float, next_state: int, terminated: bool) -> void:
+	var target := reward
+	# Time-limit truncation still bootstraps; goal and pit transitions do not.
+	if not terminated:
+		target += GAMMA * q_table[next_state][greedy_action(next_state)]
+	q_table[state][action] += ALPHA * (target - q_table[state][action])
