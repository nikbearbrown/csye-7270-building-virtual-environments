--- a/godot/npc/guard.gd
+++ b/godot/npc/guard.gd
@@ -2,11 +2,37 @@ extends CharacterBody2D
 
 const SPEED := 150.0
 
+@export var sight_radius: float = 200.0
+@export var lose_radius:  float = 350.0
+
+var last_known_player_pos: Vector2 = Vector2.ZERO
+
 @onready var nav_agent: NavigationAgent2D = $NavigationAgent2D
 
+var mode: String:
+	get:
+		var fsm := get_node_or_null("GuardFSM")
+		if fsm and fsm.current_state:
+			return fsm.current_state.name
+		return "Patrol"
+
+func _ready() -> void:
+	var label: Label = $ModeLabel
+	label.text = mode
+	$GuardFSM.state_changed.connect(func(_s: Node) -> void:
+		label.text = mode
+	)
+
 func set_target(pos: Vector2) -> void:
 	nav_agent.target_position = pos
 
+func has_line_of_sight(target: Node2D) -> bool:
+	var space_state := get_world_2d().direct_space_state
+	var query := PhysicsRayQueryParameters2D.create(global_position, target.global_position)
+	query.exclude = [self]
+	var result := space_state.intersect_ray(query)
+	return result.is_empty() or result.get("collider") == target
+
 func _physics_process(_delta: float) -> void:
 	if nav_agent.is_navigation_finished():
 		return
