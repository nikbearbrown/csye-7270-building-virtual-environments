+extends Node2D
+
+# Arena: 1280x720, walls 20px thick → walkable (20,20)-(1260,700)
+# Obstacle: 240x200 centered at (640,360) → collision (520,260)-(760,460)
+# Nav hole: obstacle + 20px guard-radius margin → (500,240)-(780,480)
+
+func _ready() -> void:
+	_build_nav_polygon()
+
+func _build_nav_polygon() -> void:
+	var region: NavigationRegion2D = $NavigationRegion2D
+	var poly := NavigationPolygon.new()
+
+	# 12 vertices: two points on the top/bottom boundary rows, four on each
+	# of the two middle rows (flanking the obstacle hole).
+	#
+	# Row 0 (y=20):   v0=(20,20)   v1=(1260,20)
+	# Row 1 (y=240):  v2=(20,240)  v3=(500,240)  v4=(780,240)  v5=(1260,240)
+	# Row 2 (y=480):  v6=(20,480)  v7=(500,480)  v8=(780,480)  v9=(1260,480)
+	# Row 3 (y=700):  v10=(20,700) v11=(1260,700)
+	#
+	# Triangles are chosen so every strip-pair shares a full edge (same two
+	# vertex indices, reversed), giving a fully-connected navigation graph.
+	poly.vertices = PackedVector2Array([
+		Vector2(20, 20),    # 0
+		Vector2(1260, 20),  # 1
+		Vector2(20, 240),   # 2
+		Vector2(500, 240),  # 3
+		Vector2(780, 240),  # 4
+		Vector2(1260, 240), # 5
+		Vector2(20, 480),   # 6
+		Vector2(500, 480),  # 7
+		Vector2(780, 480),  # 8
+		Vector2(1260, 480), # 9
+		Vector2(20, 700),   # 10
+		Vector2(1260, 700), # 11
+	])
+
+	# Top strip (y 20-240), fan from v0.  Generates edges 5-4, 4-3, 3-2
+	# that are shared as the top edges of right-strip, (unused mid), left-strip.
+	poly.add_polygon(PackedInt32Array([0, 1, 5])) # T1: shares (1,5)→boundary
+	poly.add_polygon(PackedInt32Array([0, 5, 4])) # T2: shares (5,4) with T7
+	poly.add_polygon(PackedInt32Array([0, 4, 3])) # T3: (internal top-strip)
+	poly.add_polygon(PackedInt32Array([0, 3, 2])) # T4: shares (3,2) with T5
+
+	# Left strip (x 20-500, y 240-480).  Top edge (2,3) shared with T4.
+	poly.add_polygon(PackedInt32Array([2, 3, 7])) # T5: shares (7,2) with T6
+	poly.add_polygon(PackedInt32Array([2, 7, 6])) # T6: shares (7,6) with T9
+
+	# Right strip (x 780-1260, y 240-480).  Top edge (4,5) shared with T2.
+	poly.add_polygon(PackedInt32Array([4, 5, 9])) # T7: shares (9,4) with T8
+	poly.add_polygon(PackedInt32Array([4, 9, 8])) # T8: shares (9,8) with T11
+
+	# Bottom strip (y 480-700), fan from v10.  Generates edges (6,7), (7,8),
+	# (8,9) shared with left/mid/right strips above.
+	poly.add_polygon(PackedInt32Array([10, 6, 7]))  # T9:  shares (6,7) with T6
+	poly.add_polygon(PackedInt32Array([10, 7, 8]))  # T10: (internal bottom)
+	poly.add_polygon(PackedInt32Array([10, 8, 9]))  # T11: shares (8,9) with T8
+	poly.add_polygon(PackedInt32Array([10, 9, 11])) # T12: boundary
+
+	region.navigation_polygon = poly
