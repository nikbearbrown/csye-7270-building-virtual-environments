+++ b/godot/npc/guard.gd
@@ -0,0 +1,58 @@
+extends CharacterBody2D
+
+const SPEED := 150.0
+const GuardBT = preload("res://npc/guard_bt.gd")
+enum Brain { FSM, BT }
+
+# Choose before entering the scene tree.
+@export var brain: Brain = Brain.FSM
+var _bt: RefCounted
+var _mode := "Patrol"
+
+@export var sight_radius: float = 200.0
+@export var lose_radius:  float = 350.0
+
+var last_known_player_pos: Vector2 = Vector2.ZERO
+
+@onready var nav_agent: NavigationAgent2D = $NavigationAgent2D
+
+var mode: String:
+	get:
+		return _mode
+
+func set_mode(value: String) -> void:
+	_mode = value
+	if is_node_ready():
+		$ModeLabel.text = value
+
+func _ready() -> void:
+	if brain == Brain.BT:
+		_bt = GuardBT.new()
+	else:
+		$GuardFSM.state_changed.connect(func(state: Node) -> void:
+			set_mode(state.name)
+		)
+		set_mode($GuardFSM.current_state.name)
+	$ModeLabel.text = mode
+
+func set_target(pos: Vector2) -> void:
+	nav_agent.target_position = pos
+
+func has_line_of_sight(target: Node2D) -> bool:
+	var space_state := get_world_2d().direct_space_state
+	var query := PhysicsRayQueryParameters2D.create(global_position, target.global_position)
+	query.exclude = [self]
+	var result := space_state.intersect_ray(query)
+	return result.is_empty() or result.get("collider") == target
+
+func _physics_process(delta: float) -> void:
+	if brain == Brain.BT:
+		_bt.tick(self, get_parent().get_node("Player"), delta)
+	if nav_agent.is_navigation_finished():
+		return
+	var next_pos := nav_agent.get_next_path_position()
+	var to_next := next_pos - global_position
+	if to_next.length_squared() < 1.0:
+		return
+	velocity = to_next.normalized() * SPEED
+	move_and_slide()
