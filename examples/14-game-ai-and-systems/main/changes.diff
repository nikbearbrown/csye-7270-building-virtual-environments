--- /dev/null
+++ b/godot/npc/states/chase.gd
@@ -0,0 +1,25 @@
+extends "res://npc/guard_state.gd"
+
+const RETARGET_INTERVAL := 0.2
+
+var _retarget_timer: float = 0.0
+
+func enter() -> void:
+	guard.last_known_player_pos = player.global_position
+	guard.set_target(player.global_position)
+	_retarget_timer = RETARGET_INTERVAL
+
+func update(delta: float) -> void:
+	var dist: float = guard.global_position.distance_to(player.global_position)
+	var has_los: bool = guard.has_line_of_sight(player)
+
+	if dist > guard.lose_radius or not has_los:
+		finished.emit("Search")
+		return
+
+	# Still chasing: track last known position and retarget at most every 0.2 s.
+	guard.last_known_player_pos = player.global_position
+	_retarget_timer -= delta
+	if _retarget_timer <= 0.0:
+		guard.set_target(player.global_position)
+		_retarget_timer = RETARGET_INTERVAL
