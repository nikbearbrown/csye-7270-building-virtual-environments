diff --git a/godot/npc/guard_bt.gd b/godot/npc/guard_bt.gd
new file mode 100644
index 0000000..e836abd
--- /dev/null
+++ b/godot/npc/guard_bt.gd
@@ -0,0 +1,87 @@
+extends RefCounted
+
+const BTNode = preload("res://npc/bt/bt_node.gd")
+const Selector = preload("res://npc/bt/selector.gd")
+const Sequence = preload("res://npc/bt/sequence.gd")
+const Condition = preload("res://npc/bt/condition.gd")
+const Action = preload("res://npc/bt/action.gd")
+const Patrol = preload("res://npc/states/patrol.gd")
+
+var blackboard: Dictionary = {
+	"has_last_known_position": false,
+	"waypoint": 0,
+	"retarget_timer": 0.0,
+	"waiting": false,
+	"wait_timer": 0.0,
+}
+var _root: RefCounted
+
+func _init() -> void:
+	_root = Selector.new([
+		Sequence.new([Condition.new(_can_see_player), Action.new(_chase)]),
+		Sequence.new([Condition.new(_has_last_known_position), Action.new(_search)]),
+		Action.new(_patrol),
+	])
+
+func tick(guard: Node, player: Node2D, delta: float) -> void:
+	# Pass scene references only for the tick, avoiding a reference cycle.
+	blackboard.guard = guard
+	blackboard.player = player
+	_root.tick(blackboard, delta)
+	blackboard.erase("guard")
+	blackboard.erase("player")
+
+func _can_see_player(bb: Dictionary) -> bool:
+	return bb.guard.global_position.distance_to(bb.player.global_position) <= bb.guard.sight_radius \
+		and bb.guard.has_line_of_sight(bb.player)
+
+func _has_last_known_position(bb: Dictionary) -> bool:
+	return bb.has_last_known_position
+
+func _chase(bb: Dictionary, delta: float) -> BTNode.Status:
+	var guard = bb.guard
+	var player = bb.player
+	if guard.mode == "Chase":
+		if guard.global_position.distance_to(player.global_position) > guard.lose_radius \
+				or not guard.has_line_of_sight(player):
+			return BTNode.Status.FAILURE
+		bb.retarget_timer -= delta
+	else:
+		guard.set_mode("Chase")
+		bb.retarget_timer = 0.0
+	guard.last_known_player_pos = player.global_position
+	bb.has_last_known_position = true
+	if bb.retarget_timer <= 0.0:
+		guard.set_target(player.global_position)
+		bb.retarget_timer = 0.2
+	return BTNode.Status.RUNNING
+
+func _search(bb: Dictionary, delta: float) -> BTNode.Status:
+	var guard = bb.guard
+	if guard.mode != "Search":
+		guard.set_mode("Search")
+		guard.set_target(guard.last_known_player_pos)
+		bb.waiting = false
+		bb.wait_timer = 0.0
+	if bb.waiting:
+		bb.wait_timer -= delta
+		if bb.wait_timer <= 0.0:
+			bb.has_last_known_position = false
+			# FAILURE lets the Selector fall through to Patrol in this tick.
+			return BTNode.Status.FAILURE
+	elif guard.global_position.distance_to(guard.last_known_player_pos) < 64.0:
+		bb.waiting = true
+		bb.wait_timer = 1.0
+	return BTNode.Status.RUNNING
+
+func _patrol(bb: Dictionary, _delta: float) -> BTNode.Status:
+	var guard = bb.guard
+	if guard.mode != "Patrol" or not bb.get("patrol_target_set", false):
+		guard.set_mode("Patrol")
+		guard.set_target(Patrol.WAYPOINTS[bb.waypoint])
+		bb.patrol_target_set = true
+	if guard.global_position.distance_to(Patrol.WAYPOINTS[bb.waypoint]) < 64.0:
+		bb.waypoint = (bb.waypoint + 1) % Patrol.WAYPOINTS.size()
+		guard.set_target(Patrol.WAYPOINTS[bb.waypoint])
+	# Complete each patrol tick so sight is tested again on the next tick.
+	return BTNode.Status.SUCCESS
diff --git a/godot/npc/guard_fsm.gd b/godot/npc/guard_fsm.gd
