+extends "res://npc/guard_state.gd"
+
+# Four waypoints that form a loop around the obstacle.
+const WAYPOINTS := [
+	Vector2(160, 160),   # top-left
+	Vector2(1100, 160),  # top-right
+	Vector2(1100, 560),  # bottom-right
+	Vector2(160, 560),   # bottom-left
+]
+const ARRIVAL_DIST := 64.0
+
+var _wp_idx: int = 0
+var _target_set: bool = false
+
+func enter() -> void:
+	_target_set = false
+
+func update(_delta: float) -> void:
+	if not _target_set:
+		_target_set = true
+		guard.set_target(WAYPOINTS[_wp_idx])
+	if guard.global_position.distance_to(WAYPOINTS[_wp_idx]) < ARRIVAL_DIST:
+		_wp_idx = (_wp_idx + 1) % WAYPOINTS.size()
+		guard.set_target(WAYPOINTS[_wp_idx])
+
+	var dist: float = guard.global_position.distance_to(player.global_position)
+	if dist <= guard.sight_radius and guard.has_line_of_sight(player):
+		guard.last_known_player_pos = player.global_position
+		finished.emit("Chase")
