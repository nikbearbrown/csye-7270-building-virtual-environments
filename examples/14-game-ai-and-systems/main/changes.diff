--- /dev/null
+++ b/godot/npc/guard_fsm.gd
@@ -0,0 +1,22 @@
+extends "res://state_machine/state_machine.gd"
+
+func _enter_tree() -> void:
+	var guard_node := get_parent()
+	if guard_node.brain != guard_node.Brain.FSM:
+		# Callback processing can be enabled automatically during startup.
+		# Disable this whole branch so the uninitialized FSM cannot tick or
+		# receive input, even after its inherited callbacks are registered.
+		process_mode = Node.PROCESS_MODE_DISABLED
+		return
+	var player_node := guard_node.get_parent().get_node("Player")
+	for child in get_children():
+		child.guard = guard_node
+		child.player = player_node
+	super._enter_tree()
+
+func _ready() -> void:
+	states_map = {
+		"Patrol": $Patrol,
+		"Chase":  $Chase,
+		"Search": $Search,
+	}
