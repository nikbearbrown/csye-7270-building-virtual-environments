diff --git a/godot/npc/bt/selector.gd b/godot/npc/bt/selector.gd
new file mode 100644
index 0000000..694c5ba
--- /dev/null
+++ b/godot/npc/bt/selector.gd
@@ -0,0 +1,24 @@
+extends "res://npc/bt/bt_node.gd"
+
+var children: Array
+var _index := 0
+
+func _init(nodes: Array = []) -> void:
+	children = nodes
+
+func tick(blackboard: Dictionary, delta: float) -> Status:
+	while _index < children.size():
+		var result: Status = children[_index].tick(blackboard, delta)
+		if result == Status.RUNNING:
+			return result
+		if result == Status.SUCCESS:
+			reset()
+			return result
+		_index += 1
+	reset()
+	return Status.FAILURE
+
+func reset() -> void:
+	_index = 0
+	for child in children:
+		child.reset()
